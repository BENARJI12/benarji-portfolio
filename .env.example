# ==========================================
# Flask Application Environment Variables
# ==========================================

# Flask Security Key (Change this in production to a secure random string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-very-secure-random-secret-key-32-chars-or-more

# Environment ('development', 'production', 'testing')
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Portfolio Owner & Contact Details
PORTFOLIO_OWNER_NAME=P. Benarji Rathnam
CONTACT_RECIPIENT_EMAIL=benarjip69@gmail.com

# SMTP Email Configuration (Optional - for real email dispatch)
# When left empty, messages are safely logged in local development mode
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="P. Benarji Rathnam Portfolio <no-reply@benarji.dev>"

# Rate Limiting Configuration
# Limits number of contact form submissions per IP per time window
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600

# AWS Deployment Configuration (Planned Architecture)
AWS_REGION=ap-south-1
DYNAMODB_TABLE_NAME=PortfolioContactSubmissions
SES_SENDER_EMAIL=benarjip69@gmail.com
